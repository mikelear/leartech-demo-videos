[14.4, "o", "\u001b[3J\u001b[H\u001b[2J\n  \u001b[1mOne PR, four screens\u001b[0m   \u001b[38;5;244m\u001b[0m\n\n\u001b[38;5;42m\u256d\u2500\u001b[0m \u001b[1mTHE THREAD\u001b[0m \u001b[38;5;42m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;42m\u256e\u001b[0m\n\u001b[38;5;42m\u2502\u001b[0m \u001b[38;5;42m\u2714\u001b[0m review card   \u001b[38;5;244m\u2014 PR #239, title, state\u001b[0m               \u001b[38;5;42m\u2502\u001b[0m\n\u001b[38;5;42m\u2502\u001b[0m \u001b[38;5;42m\u2714\u001b[0m diff hunk     \u001b[38;5;244m\u2014 the audience fix + proven-by test\u001b[0m   \u001b[38;5;42m\u2502\u001b[0m\n\u001b[38;5;42m\u2502\u001b[0m \u001b[38;5;42m\u2714\u001b[0m CI gates      \u001b[38;5;244m\u2014 run on head be8dffc\u001b[0m                 \u001b[38;5;42m\u2502\u001b[0m\n\u001b[38;5;42m\u2502\u001b[0m \u001b[38;5;42m\u2714\u001b[0m terminal      \u001b[38;5;244m\u2014 gh pr view, the source of all of it\u001b[0m \u001b[38;5;42m\u2502\u001b[0m\n\u001b[38;5;42m\u2570\u001b[0m\u001b[38;5;42m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;42m\u256f\u001b[0m\n  \u001b[38;5;244mCALLOUT:\u001b[0m they are the same object #239 \u2014 PR number + \u001b[38;5;221mhead sha\u001b[0m are the links"]
