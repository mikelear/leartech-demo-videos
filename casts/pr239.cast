[0.0, "o", "\u001b[3J\u001b[H\u001b[2J\n  \u001b[1mPull Request #239\u001b[0m   \u001b[38;5;244mmikelear/leartech-orchestrator-controller\u001b[0m\n\n  \u001b[38;5;42m\u276f\u001b[0m gh pr view 239 --repo mikelear/leartech-orchestrator-controller\n\n\u001b[38;5;177m\u256d\u2500\u001b[0m \u001b[1mPR #239 \u00b7 CODE REVIEW\u001b[0m \u001b[38;5;177m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;177m\u256e\u001b[0m\n\u001b[38;5;177m\u2502\u001b[0m \u001b[38;5;250mfix(maestro): announce with aud=leartech-maestro-service\u001b[0m \u001b[38;5;177m\u2502\u001b[0m\n\u001b[38;5;177m\u2502\u001b[0m \u001b[38;5;244mstate \u001b[0m\u001b[48;5;28;38;5;231m OPEN \u001b[0m   \u001b[38;5;244mfiles \u001b[0m\u001b[38;5;250m2\u001b[0m  \u001b[38;5;42m+26\u001b[0m \u001b[38;5;203m-1\u001b[0m                           \u001b[38;5;177m\u2502\u001b[0m\n\u001b[38;5;177m\u2502\u001b[0m \u001b[38;5;244mbranch\u001b[0m \u001b[38;5;75mfix/maestro-announce-audience \u2192 main\u001b[0m              \u001b[38;5;177m\u2502\u001b[0m\n\u001b[38;5;177m\u2502\u001b[0m \u001b[38;5;244mhead  \u001b[0m \u001b[38;5;221mbe8dffc\u001b[0m                                           \u001b[38;5;177m\u2502\u001b[0m\n\u001b[38;5;177m\u2502\u001b[0m \u001b[38;5;244mauthor\u001b[0m \u001b[38;5;250mmikelear\u001b[0m                                          \u001b[38;5;177m\u2502\u001b[0m\n\u001b[38;5;177m\u2570\u001b[0m\u001b[38;5;177m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;177m\u256f\u001b[0m\n  \u001b[38;5;244mCALLOUT:\u001b[0m the Terminal PR #239 is the same object as \u001b[38;5;177mthe review card \u2191\u001b[0m\n"]
[3.6, "o", "\u001b[3J\u001b[H\u001b[2J\n  \u001b[1mWhy this PR exists\u001b[0m   \u001b[38;5;244msymptom \u2192 root cause \u2192 fix\u001b[0m\n\n\u001b[38;5;215m\u256d\u2500\u001b[0m \u001b[1mSYMPTOM\u001b[0m \u001b[38;5;215m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;215m\u256e\u001b[0m\n\u001b[38;5;215m\u2502\u001b[0m \u001b[38;5;250mEvery plan stalls at its first step. Controller logs\u001b[0m          \u001b[38;5;215m\u2502\u001b[0m\n\u001b[38;5;215m\u2502\u001b[0m \u001b[38;5;203m  maestro: unexpected status 401 announcing run.completed\u001b[0m     \u001b[38;5;215m\u2502\u001b[0m\n\u001b[38;5;215m\u2502\u001b[0m \u001b[38;5;250mSteps sit AwaitingReview forever (seen: fx-ticker bootstrap).\u001b[0m \u001b[38;5;215m\u2502\u001b[0m\n\u001b[38;5;215m\u2570\u001b[0m\u001b[38;5;215m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;215m\u256f\u001b[0m\n\u001b[38;5;75m\u256d\u2500\u001b[0m \u001b[1mROOT CAUSE \u2014 not a maestro code change\u001b[0m \u001b[38;5;75m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;75m\u256e\u001b[0m\n\u001b[38;5;75m\u2502\u001b[0m \u001b[38;5;250mmaestro 0.0.29 \u2261 0.0.30 byte-identical. Enforcement arrived:\u001b[0m      \u001b[38;5;75m\u2502\u001b[0m\n\u001b[38;5;75m\u2502\u001b[0m \u001b[38;5;250mit now verifies\u001b[0m \u001b[38;5;80maud=leartech-maestro-service\u001b[0m \u001b[38;5;250minbound.\u001b[0m             \u001b[38;5;75m\u2502\u001b[0m\n\u001b[38;5;75m\u2502\u001b[0m \u001b[38;5;250mThe controller minted an\u001b[0m \u001b[38;5;203maudience-less\u001b[0m \u001b[38;5;250mtoken \u2192 401.\u001b[0m               \u001b[38;5;75m\u2502\u001b[0m\n\u001b[38;5;75m\u2502\u001b[0m \u001b[38;5;244mThe authgraph predicted this edge on 2026-09-12 (Enforced:false).\u001b[0m \u001b[38;5;75m\u2502\u001b[0m\n\u001b[38;5;75m\u2570\u001b[0m\u001b[38;5;75m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;75m\u256f\u001b[0m\n  \u001b[38;5;244mCALLOUT:\u001b[0m the fix adds the audience the token was missing\n"]
[7.2, "o", "\u001b[3J\u001b[H\u001b[2J\n  \u001b[1mThe fix \u2194 the code\u001b[0m   \u001b[38;5;244minternal/controller/maestro_producer.go\u001b[0m\n\n\u001b[38;5;75m\u256d\u2500\u001b[0m \u001b[1mmaestro_producer.go  (\u001b[38;5;42m+10\u001b[0m \u001b[38;5;203m-1\u001b[0m)\u001b[0m \u001b[38;5;75m\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;75m\u256e\u001b[0m\n\u001b[38;5;75m\u2502\u001b[0m \u001b[38;5;80m@@ const + MaestroAudience @@\u001b[0m                                   \u001b[38;5;75m\u2502\u001b[0m\n\u001b[38;5;75m\u2502\u001b[0m \u001b[38;5;42m+ // MaestroAudience is the aud claim maestro enforces inbound.\u001b[0m \u001b[38;5;75m\u2502\u001b[0m\n\u001b[38;5;75m\u2502\u001b[0m \u001b[38;5;42m+ // proven-by: TestNewMaestroProducer_MintsTheMaestroAudience\u001b[0m  \u001b[38;5;75m\u2502\u001b[0m\n\u001b[38;5;75m\u2502\u001b[0m \u001b[38;5;42m+ const MaestroAudience = \"leartech-maestro-service\"\u001b[0m            \u001b[38;5;75m\u2502\u001b[0m\n\u001b[38;5;75m\u2502\u001b[0m \u001b[38;5;244m  func NewMaestroProducer(baseURL string) ... {\u001b[0m                 \u001b[38;5;75m\u2502\u001b[0m\n\u001b[38;5;75m\u2502\u001b[0m \u001b[38;5;203m-   hc := authedHTTPClient()\u001b[0m                                    \u001b[38;5;75m\u2502\u001b[0m\n\u001b[38;5;75m\u2502\u001b[0m \u001b[38;5;42m+   hc := authedHTTPClientForAudience(MaestroAudience)\u001b[0m          \u001b[38;5;75m\u2502\u001b[0m\n\u001b[38;5;75m\u2570\u001b[0m\u001b[38;5;75m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;75m\u256f\u001b[0m\n\u001b[38;5;215m\u256d\u2500\u001b[0m \u001b[1mcomment-gate \u00b7 the test that proves it\u001b[0m \u001b[38;5;215m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;215m\u256e\u001b[0m\n\u001b[38;5;215m\u2502\u001b[0m \u001b[38;5;80mproven-by\u001b[0m \u001b[38;5;250mTestNewMaestroProducer_MintsTheMaestroAudience\u001b[0m            \u001b[38;5;215m\u2502\u001b[0m\n\u001b[38;5;215m\u2502\u001b[0m \u001b[38;5;244masserts cfg.EndpointParams.Get(\"audience\") == the maestro audience,\u001b[0m \u001b[38;5;215m\u2502\u001b[0m\n\u001b[38;5;215m\u2502\u001b[0m \u001b[38;5;244mor maestro 401s the announce.\u001b[0m                                       \u001b[38;5;215m\u2502\u001b[0m\n\u001b[38;5;215m\u2570\u001b[0m\u001b[38;5;215m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;215m\u256f\u001b[0m\n  \u001b[38;5;244mCALLOUT:\u001b[0m prose that asserts behaviour names a \u001b[38;5;80mproven-by\u001b[0m test \u2014 that is the gate\n"]
[10.8, "o", "\u001b[3J\u001b[H\u001b[2J\n  \u001b[1mCI gates @ be8dffc\u001b[0m   \u001b[38;5;244mthe HEAD SHA links review \u2194 gates\u001b[0m\n\n\u001b[38;5;80m\u256d\u2500\u001b[0m \u001b[1mGATES \u00b7 PR #239 @ be8dffc\u001b[0m \u001b[38;5;80m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;80m\u256e\u001b[0m\n\u001b[38;5;80m\u2502\u001b[0m \u001b[38;5;244mgcp cluster\u001b[0m                     \u001b[38;5;244maz cluster\u001b[0m             \u001b[38;5;80m\u2502\u001b[0m\n\u001b[38;5;80m\u2502\u001b[0m \u001b[38;5;42m\u2714\u001b[0m gcp/lint          \u001b[38;5;244mpass\u001b[0m   \u001b[38;5;42m\u2714\u001b[0m az/lint          \u001b[38;5;244mpass\u001b[0m     \u001b[38;5;80m\u2502\u001b[0m\n\u001b[38;5;80m\u2502\u001b[0m \u001b[38;5;42m\u2714\u001b[0m gcp/test          \u001b[38;5;244mpass\u001b[0m   \u001b[38;5;221m\u29d7\u001b[0m  az/test          \u001b[38;5;244mrunning\u001b[0m \u001b[38;5;80m\u2502\u001b[0m\n\u001b[38;5;80m\u2502\u001b[0m \u001b[38;5;42m\u2714\u001b[0m gcp/ai-review     \u001b[38;5;244mpass\u001b[0m   \u001b[38;5;42m\u2714\u001b[0m az/ai-review     \u001b[38;5;244mpass\u001b[0m     \u001b[38;5;80m\u2502\u001b[0m\n\u001b[38;5;80m\u2502\u001b[0m \u001b[38;5;42m\u2714\u001b[0m gcp/end2end       \u001b[38;5;244mpass\u001b[0m   \u001b[38;5;42m\u2714\u001b[0m az/end2end       \u001b[38;5;244mpass\u001b[0m     \u001b[38;5;80m\u2502\u001b[0m\n\u001b[38;5;80m\u2502\u001b[0m \u001b[38;5;42m\u2714\u001b[0m gcp/govulncheck   \u001b[38;5;244mpass\u001b[0m   \u001b[38;5;42m\u2714\u001b[0m az/security-scan \u001b[38;5;244mpass\u001b[0m     \u001b[38;5;80m\u2502\u001b[0m\n\u001b[38;5;80m\u2570\u001b[0m\u001b[38;5;80m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250